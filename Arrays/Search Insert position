//Serching insert position
public class p5{
    public int searchInsertPosition(int[] nums, int target){
        for(int i=0;i<nums.length;i++){
            if(nums[i]>=target){
                return i;
            }
        }
        return nums.length;
    }

    public static void main(String[] args) {
        p5 obj=new p5();
        int[] nums={1,3,5,7};
        int target=6;
        System.out.println(obj.searchInsertPosition(nums, target));
    }
}
