//Finding length of last word in a string excluding the spaces
class Solution{
  public int lengthOfLastWord(String s){
      int count=0;
      int i=s.length()-1;
      //for blank spaces
      while(i>=0 && s.charAt(i)==' '){
        i--;
      }
      //for character of last word
      while(i>=0 && s.charAt(i)!=' '){
        count++;
        i--;
      }
      return count;
  }
}
