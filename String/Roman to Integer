//Converting Roman numbers to Integer
class Solution {
    public int romanToInt(String s) {
        int[] value= new int[128];
      //Roman numerals are represented by seven different symbols: I, V, X, L, C, D and M.
        value['I']=1;
        value['V']=5;
        value['X']=10;
        value['L']=50;
        value['C']=100;
        value['D']=500;
        value['M']=1000;

        int num=0;
        for(int i=0;i<s.length();i++){
            if(i<s.length()-1 && value[s.charAt(i)]< value[s.charAt(i+1)]){
                num-=value[s.charAt(i)];
            }else{
                num+=value[s.charAt(i)];
            }
        }
        return num;
    }
}
